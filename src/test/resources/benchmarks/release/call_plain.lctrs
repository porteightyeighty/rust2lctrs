call_plain :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> result -> result
double :: Int -> result

call_plain(x) -> u2(x, double(x)) | (-128 ≤ x) ∧ (x ≤ 127)
u2(x, ret_Int($call)) -> ret_Int(((($call + 1) - -128) % 256) + -128)
u2(x, err) -> err
double(x) -> ret_Int((((x + x) - -128) % 256) + -128) | (-128 ≤ x) ∧ (x ≤ 127)
