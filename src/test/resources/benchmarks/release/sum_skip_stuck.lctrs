sum_skip_stuck :: Int -> result
ret_Int :: Int -> result
err :: result
u2 :: Int -> Int -> Int -> result
u3 :: Int -> Int -> Int -> result

sum_skip_stuck(n) -> u2(n, 0, 0)
u2(n, i, acc) -> u3(n, i, acc) | i < n
u3(n, i, acc) -> u2(n, i, acc) | i = 5
u3(n, i, acc) -> u2(n, (((i + 1) - -32768) % 65536) + -32768, (((acc + ((((i + 1) - -32768) % 65536) + -32768)) - -32768) % 65536) + -32768) | ¬(i = 5)
u2(n, i, acc) -> ret_Int(acc) | ¬(i < n)
