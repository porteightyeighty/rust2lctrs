mccarthy :: Int -> result
ret_Int :: Int -> result
err :: result
u2 :: Int -> result -> result
u4 :: Int -> Int -> result -> result

mccarthy(n) -> u2(n, mccarthy((((n + 11) - -2147483648) % 4294967296) + -2147483648)) | n ≤ 100
u2(n, ret_Int($call)) -> u4(n, $call, mccarthy($call))
u2(n, err) -> err
u4(n, $call, ret_Int($call_1)) -> ret_Int($call_1)
u4(n, $call, err) -> err
mccarthy(n) -> ret_Int((((n - 10) - -2147483648) % 4294967296) + -2147483648) | ¬(n ≤ 100)
