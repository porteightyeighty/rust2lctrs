mccarthy :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> result
private u3 :: Int -> result -> result
private u5 :: Int -> Int -> result -> result

mccarthy(n) -> u1(n) | (-2147483648 ≤ n) ∧ (n ≤ 2147483647)
u1(n) -> u3(n, mccarthy((((n + 11) - -2147483648) % 4294967296) + -2147483648)) | n ≤ 100
u3(n, ret_Int($call)) -> u5(n, $call, mccarthy($call))
u3(n, err) -> err
u5(n, $call, ret_Int($call_1)) -> ret_Int($call_1)
u5(n, $call, err) -> err
u1(n) -> ret_Int((((n - 10) - -2147483648) % 4294967296) + -2147483648) | ¬(n ≤ 100)
