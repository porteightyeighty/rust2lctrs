div_cond :: Int -> Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> Int -> result
private u2 :: Int -> Int -> Int -> result

div_cond(a, b) -> u1(a, b) | ((-32768 ≤ a) ∧ (a ≤ 32767)) ∧ ((-32768 ≤ b) ∧ (b ≤ 32767))
u1(a, b) -> err | ¬((b ≠ 0) ∧ ¬((a = -32768) ∧ (b = -1)))
u1(a, b) -> u2(a, b, $div) | (((b ≠ 0) ∧ ¬((a = -32768) ∧ (b = -1))) ∧ ((a ≥ 0) ∨ ((a % b) = 0))) ∧ ($div = (a / b))
u1(a, b) -> u2(a, b, $div) | (((b ≠ 0) ∧ ¬((a = -32768) ∧ (b = -1))) ∧ (((a < 0) ∧ ((a % b) ≠ 0)) ∧ (b > 0))) ∧ ($div = ((a / b) + 1))
u1(a, b) -> u2(a, b, $div) | (((b ≠ 0) ∧ ¬((a = -32768) ∧ (b = -1))) ∧ (((a < 0) ∧ ((a % b) ≠ 0)) ∧ (b < 0))) ∧ ($div = ((a / b) - 1))
u2(a, b, $div) -> ret_Int(1) | $div > 0
u2(a, b, $div) -> ret_Int(0) | ¬($div > 0)
