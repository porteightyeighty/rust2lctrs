is_even :: Int -> result
private ret_Bool :: Bool -> result
private err :: result
private u1 :: Int -> result
private u4 :: Int -> result -> result
is_odd :: Int -> result
private u6 :: Int -> result
private u9 :: Int -> result -> result

is_even(n) -> u1(n) | (-128 ≤ n) ∧ (n ≤ 127)
u1(n) -> ret_Bool(true) | n = 0
u1(n) -> u4(n, is_odd((((n - 1) - -128) % 256) + -128)) | ¬(n = 0)
u4(n, ret_Bool($call)) -> ret_Bool($call)
u4(n, err) -> err
is_odd(n) -> u6(n) | (-128 ≤ n) ∧ (n ≤ 127)
u6(n) -> ret_Bool(false) | n = 0
u6(n) -> u9(n, is_even((((n - 1) - -128) % 256) + -128)) | ¬(n = 0)
u9(n, ret_Bool($call)) -> ret_Bool($call)
u9(n, err) -> err
