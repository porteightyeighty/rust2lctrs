sum_skip :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u3 :: Int -> Int -> Int -> result
private u5 :: Int -> Int -> Int -> result

sum_skip(n) -> u3(n, 0, 0) | (-32768 ≤ n) ∧ (n ≤ 32767)
u3(n, i, acc) -> u5(n, (((i + 1) - -32768) % 65536) + -32768, acc) | i < n
u5(n, i, acc) -> u3(n, i, acc) | i = 5
u5(n, i, acc) -> u3(n, i, (((acc + i) - -32768) % 65536) + -32768) | ¬(i = 5)
u3(n, i, acc) -> ret_Int(acc) | ¬(i < n)
