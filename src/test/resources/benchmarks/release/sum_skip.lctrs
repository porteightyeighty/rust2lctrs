sum_skip :: Int -> result
ret_Int :: Int -> result
err :: result
u2 :: Int -> Int -> Int -> result
u4 :: Int -> Int -> Int -> result

sum_skip(n) -> u2(n, 0, 0)
u2(n, i, acc) -> u4(n, (((i + 1) - -32768) % 65536) + -32768, acc) | i < n
u4(n, i, acc) -> u2(n, i, acc) | i = 5
u4(n, i, acc) -> u2(n, i, (((acc + i) - -32768) % 65536) + -32768) | ¬(i = 5)
u2(n, i, acc) -> ret_Int(acc) | ¬(i < n)
