widths :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
private ret_Int :: Int -> result
private err :: result
private u7 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result

widths(a, b, c, d, e, f, n) -> u7(a, b, c, d, e, f, n, (a + 1) % 65536, (b + 1) % 4294967296, (c + 1) % 18446744073709551616, (d + 1) % 340282366920938463463374607431768211456, (((e + 1) - -9223372036854775808) % 18446744073709551616) + -9223372036854775808, (((f + 1) - -170141183460469231731687303715884105728) % 340282366920938463463374607431768211456) + -170141183460469231731687303715884105728) | (((((((0 ≤ a) ∧ (a ≤ 65535)) ∧ ((0 ≤ b) ∧ (b ≤ 4294967295))) ∧ ((0 ≤ c) ∧ (c ≤ 18446744073709551615))) ∧ ((0 ≤ d) ∧ (d ≤ 340282366920938463463374607431768211455))) ∧ ((-9223372036854775808 ≤ e) ∧ (e ≤ 9223372036854775807))) ∧ ((-170141183460469231731687303715884105728 ≤ f) ∧ (f ≤ 170141183460469231731687303715884105727))) ∧ ((0 ≤ n) ∧ (n ≤ 255))
u7(a, b, c, d, e, f, n, p, q, r, s, t, u) -> u7(a, b, c, d, e, f, (n - 1) % 256, p, q, r, s, t, u) | n > 0
u7(a, b, c, d, e, f, n, p, q, r, s, t, u) -> ret_Int(n) | ¬(n > 0)
