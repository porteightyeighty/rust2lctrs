widths :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
ret_Int :: Int -> result
err :: result
u6 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result

widths(a, b, c, d, e, f, n) -> u6(a, b, c, d, e, f, n, (a + 1) % 65536, (b + 1) % 4294967296, (c + 1) % 18446744073709551616, (d + 1) % 340282366920938463463374607431768211456, (((e + 1) - -9223372036854775808) % 18446744073709551616) + -9223372036854775808, (((f + 1) - -170141183460469231731687303715884105728) % 340282366920938463463374607431768211456) + -170141183460469231731687303715884105728)
u6(a, b, c, d, e, f, n, p, q, r, s, t, u) -> u6(a, b, c, d, e, f, (n - 1) % 256, p, q, r, s, t, u) | n > 0
u6(a, b, c, d, e, f, n, p, q, r, s, t, u) -> ret_Int(n) | ¬(n > 0)
