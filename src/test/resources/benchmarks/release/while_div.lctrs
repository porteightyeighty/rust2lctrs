while_div :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> result
private u4 :: Int -> Int -> Int -> result

while_div(n) -> u1(n) | (-32768 ≤ n) ∧ (n ≤ 32767)
u1(n) -> u4(n, $div, 0) | ((n ≥ 0) ∨ ((n % 2) = 0)) ∧ ($div = (n / 2))
u1(n) -> u4(n, $div, 0) | ((n < 0) ∧ ((n % 2) ≠ 0)) ∧ ($div = ((n / 2) + 1))
u4(n, half, i) -> u4(n, half, (((i + 1) - -32768) % 65536) + -32768) | i < half
u4(n, half, i) -> ret_Int(i) | ¬(i < half)
