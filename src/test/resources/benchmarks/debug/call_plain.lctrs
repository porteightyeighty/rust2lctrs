call_plain :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> result -> result
private u4 :: Int -> Int -> result
double :: Int -> result
private u5 :: Int -> result

call_plain(x) -> u2(x, double(x)) | (-128 ≤ x) ∧ (x ≤ 127)
u2(x, ret_Int($call)) -> u4(x, $call)
u2(x, err) -> err
u4(x, y) -> err | ¬((-128 ≤ (y + 1)) ∧ ((y + 1) ≤ 127))
u4(x, y) -> ret_Int(y + 1) | (-128 ≤ (y + 1)) ∧ ((y + 1) ≤ 127)
double(x) -> u5(x) | (-128 ≤ x) ∧ (x ≤ 127)
u5(x) -> err | ¬((-128 ≤ (x + x)) ∧ ((x + x) ≤ 127))
u5(x) -> ret_Int(x + x) | (-128 ≤ (x + x)) ∧ ((x + x) ≤ 127)
