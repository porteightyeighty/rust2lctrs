widths :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
ret_Int :: Int -> result
err :: result
u1 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
u2 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
