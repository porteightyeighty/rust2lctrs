widths :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
private u2 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
private u3 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> result
