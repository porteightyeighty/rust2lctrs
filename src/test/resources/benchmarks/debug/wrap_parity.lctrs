wrap_parity :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> Int -> result
private u3 :: Int -> Int -> result

wrap_parity(x) -> u2(x, 0) | (-32768 ≤ x) ∧ (x ≤ 32767)
u2(x, i) -> u3(x, i) | i ≠ x
u3(x, i) -> err | ¬((-32768 ≤ (i + 2)) ∧ ((i + 2) ≤ 32767))
u3(x, i) -> u2(x, i + 2) | (-32768 ≤ (i + 2)) ∧ ((i + 2) ≤ 32767)
u2(x, i) -> ret_Int(i) | ¬(i ≠ x)
