wrap_parity :: Int -> result
ret_Int :: Int -> result
err :: result
u1 :: Int -> Int -> result
u2 :: Int -> Int -> result

wrap_parity(x) -> u1(x, 0)
u1(x, i) -> u2(x, i) | i ≠ x
u2(x, i) -> err | ¬((-32768 ≤ (i + 2)) ∧ ((i + 2) ≤ 32767))
u2(x, i) -> u1(x, i + 2) | (-32768 ≤ (i + 2)) ∧ ((i + 2) ≤ 32767)
u1(x, i) -> ret_Int(i) | ¬(i ≠ x)
