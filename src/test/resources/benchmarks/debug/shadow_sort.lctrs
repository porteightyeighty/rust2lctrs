shadow_sort :: Int -> result
ret_Int :: Int -> result
err :: result
u2 :: Int -> Int -> Bool -> result

shadow_sort(n) -> err | ¬((-128 ≤ (n + 1)) ∧ ((n + 1) ≤ 127))
shadow_sort(n) -> u2(n, n + 1, (n + 1) > 0) | (-128 ≤ (n + 1)) ∧ ((n + 1) ≤ 127)
u2(n, x, x_1) -> ret_Int(1) | x_1
u2(n, x, x_1) -> ret_Int(0) | ¬x_1
