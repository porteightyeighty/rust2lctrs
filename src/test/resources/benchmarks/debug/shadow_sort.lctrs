shadow_sort :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> result
private u3 :: Int -> Int -> Bool -> result

shadow_sort(n) -> u1(n) | (-128 ≤ n) ∧ (n ≤ 127)
u1(n) -> err | ¬((-128 ≤ (n + 1)) ∧ ((n + 1) ≤ 127))
u1(n) -> u3(n, n + 1, (n + 1) > 0) | (-128 ≤ (n + 1)) ∧ ((n + 1) ≤ 127)
u3(n, x, x_1) -> ret_Int(1) | x_1
u3(n, x, x_1) -> ret_Int(0) | ¬x_1
