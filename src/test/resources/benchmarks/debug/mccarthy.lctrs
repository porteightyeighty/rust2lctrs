mccarthy :: Int -> result
ret_Int :: Int -> result
err :: result
u1 :: Int -> result
u2 :: Int -> result -> result
u4 :: Int -> Int -> result -> result
u6 :: Int -> result

mccarthy(n) -> u1(n) | n ≤ 100
u1(n) -> err | ¬((-2147483648 ≤ (n + 11)) ∧ ((n + 11) ≤ 2147483647))
u1(n) -> u2(n, mccarthy(n + 11)) | (-2147483648 ≤ (n + 11)) ∧ ((n + 11) ≤ 2147483647)
u2(n, ret_Int($call)) -> u4(n, $call, mccarthy($call))
u2(n, err) -> err
u4(n, $call, ret_Int($call_1)) -> ret_Int($call_1)
u4(n, $call, err) -> err
mccarthy(n) -> u6(n) | ¬(n ≤ 100)
u6(n) -> err | ¬((-2147483648 ≤ (n - 10)) ∧ ((n - 10) ≤ 2147483647))
u6(n) -> ret_Int(n - 10) | (-2147483648 ≤ (n - 10)) ∧ ((n - 10) ≤ 2147483647)
