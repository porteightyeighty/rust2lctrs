mccarthy :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> result
private u2 :: Int -> result
private u3 :: Int -> result -> result
private u5 :: Int -> Int -> result -> result
private u7 :: Int -> result

mccarthy(n) -> u1(n) | (-2147483648 ≤ n) ∧ (n ≤ 2147483647)
u1(n) -> u2(n) | n ≤ 100
u2(n) -> err | ¬((-2147483648 ≤ (n + 11)) ∧ ((n + 11) ≤ 2147483647))
u2(n) -> u3(n, mccarthy(n + 11)) | (-2147483648 ≤ (n + 11)) ∧ ((n + 11) ≤ 2147483647)
u3(n, ret_Int($call)) -> u5(n, $call, mccarthy($call))
u3(n, err) -> err
u5(n, $call, ret_Int($call_1)) -> ret_Int($call_1)
u5(n, $call, err) -> err
u1(n) -> u7(n) | ¬(n ≤ 100)
u7(n) -> err | ¬((-2147483648 ≤ (n - 10)) ∧ ((n - 10) ≤ 2147483647))
u7(n) -> ret_Int(n - 10) | (-2147483648 ≤ (n - 10)) ∧ ((n - 10) ≤ 2147483647)
