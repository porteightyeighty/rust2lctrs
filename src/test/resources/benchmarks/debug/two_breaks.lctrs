two_breaks :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> result
private u2 :: Int -> result
private u4 :: Int -> result
private u5 :: Int -> result

two_breaks(x) -> u1(x) | (-32768 ≤ x) ∧ (x ≤ 32767)
u1(x) -> u2(x) | x < 100
u2(x) -> ret_Int(x) | x = 42
u2(x) -> u4(x) | ¬(x = 42)
u4(x) -> err | ¬((-32768 ≤ (x + 7)) ∧ ((x + 7) ≤ 32767))
u4(x) -> u5(x + 7) | (-32768 ≤ (x + 7)) ∧ ((x + 7) ≤ 32767)
u5(x) -> ret_Int(x) | x > 80
u5(x) -> u1(x) | ¬(x > 80)
u1(x) -> ret_Int(x) | ¬(x < 100)
