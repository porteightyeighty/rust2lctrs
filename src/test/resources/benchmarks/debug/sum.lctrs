sum :: Int -> Int -> result
private ret_Int :: Int -> result
private err :: result
private u1 :: Int -> Int -> result

sum(a, b) -> u1(a, b) | ((-128 ≤ a) ∧ (a ≤ 127)) ∧ ((-128 ≤ b) ∧ (b ≤ 127))
u1(a, b) -> err | ¬((-128 ≤ (a + b)) ∧ ((a + b) ≤ 127))
u1(a, b) -> ret_Int(a + b) | (-128 ≤ (a + b)) ∧ ((a + b) ≤ 127)
