wrap_count :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> Int -> result
private u3 :: Int -> Int -> result

wrap_count(x) -> u2(x, x) | (-32768 ≤ x) ∧ (x ≤ 32767)
u2(x, y) -> u3(x, y) | y > 0
u3(x, y) -> err | ¬((-32768 ≤ (y + 1)) ∧ ((y + 1) ≤ 32767))
u3(x, y) -> u2(x, y + 1) | (-32768 ≤ (y + 1)) ∧ ((y + 1) ≤ 32767)
u2(x, y) -> ret_Int(y) | ¬(y > 0)
