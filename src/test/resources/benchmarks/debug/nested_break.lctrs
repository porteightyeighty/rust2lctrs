nested_break :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> Int -> result
private u3 :: Int -> Int -> result
private u6 :: Int -> Int -> Int -> result
private u7 :: Int -> Int -> Int -> result
private u9 :: Int -> Int -> Int -> result
private u10 :: Int -> Int -> Int -> result
private u12 :: Int -> Int -> Int -> result

nested_break(x) -> u2(x, 0) | (-32768 ≤ x) ∧ (x ≤ 32767)
u2(x, total) -> u3(x, total) | x > 0
u3(x, total) -> ret_Int(total) | total > 50
u3(x, total) -> u6(x, total, x) | ¬(total > 50)
u6(x, total, y) -> u7(x, total, y) | y > 0
u7(x, total, y) -> u12(x, total, y) | y = 3
u7(x, total, y) -> u9(x, total, y) | ¬(y = 3)
u9(x, total, y) -> err | ¬((-32768 ≤ (total + 1)) ∧ ((total + 1) ≤ 32767))
u9(x, total, y) -> u10(x, total + 1, y) | (-32768 ≤ (total + 1)) ∧ ((total + 1) ≤ 32767)
u10(x, total, y) -> err | ¬((-32768 ≤ (y - 1)) ∧ ((y - 1) ≤ 32767))
u10(x, total, y) -> u6(x, total, y - 1) | (-32768 ≤ (y - 1)) ∧ ((y - 1) ≤ 32767)
u6(x, total, y) -> u12(x, total, y) | ¬(y > 0)
u12(x, total, y) -> err | ¬((-32768 ≤ (x - 1)) ∧ ((x - 1) ≤ 32767))
u12(x, total, y) -> u2(x - 1, total) | (-32768 ≤ (x - 1)) ∧ ((x - 1) ≤ 32767)
u2(x, total) -> ret_Int(total) | ¬(x > 0)
