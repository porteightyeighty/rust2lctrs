count_down :: Int -> result
private ret_unit :: result
private err :: result
private u1 :: Int -> result
private u2 :: Int -> result

count_down(n) -> u1(n) | (-2147483648 ≤ n) ∧ (n ≤ 2147483647)
u1(n) -> u2(n) | n > 0
u2(n) -> err | ¬((-2147483648 ≤ (n - 1)) ∧ ((n - 1) ≤ 2147483647))
u2(n) -> u1(n - 1) | (-2147483648 ≤ (n - 1)) ∧ ((n - 1) ≤ 2147483647)
u1(n) -> ret_unit | ¬(n > 0)
