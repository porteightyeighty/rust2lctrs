step :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> Int -> result
private u5 :: Int -> Int -> result

step(x) -> u2(x, 0) | (-128 ≤ x) ∧ (x ≤ 127)
u2(x, y) -> ret_Int(1) | x > 0
u2(x, y) -> u5(x, y) | ¬(x > 0)
u5(x, y) -> err | ¬((-128 ≤ (x - 1)) ∧ ((x - 1) ≤ 127))
u5(x, y) -> ret_Int(x - 1) | (-128 ≤ (x - 1)) ∧ ((x - 1) ≤ 127)
