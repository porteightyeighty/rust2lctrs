step :: Int -> result
ret_Int :: Int -> result
err :: result
u1 :: Int -> Int -> result
u4 :: Int -> Int -> result

step(x) -> u1(x, 0)
u1(x, y) -> ret_Int(1) | x > 0
u1(x, y) -> u4(x, y) | ¬(x > 0)
u4(x, y) -> err | ¬((-128 ≤ (x - 1)) ∧ ((x - 1) ≤ 127))
u4(x, y) -> ret_Int(x - 1) | (-128 ≤ (x - 1)) ∧ ((x - 1) ≤ 127)
