shadow_scoped :: Int -> result
private ret_Int :: Int -> result
private err :: result
private u2 :: Int -> Int -> result
private u3 :: Int -> Int -> result

shadow_scoped(n) -> u2(n, n) | (-128 ≤ n) ∧ (n ≤ 127)
u2(n, x) -> u3(n, x) | n > 0
u3(n, x) -> err | ¬((-128 ≤ (x + 1)) ∧ ((x + 1) ≤ 127))
u3(n, x) -> ret_Int(x + 1) | (-128 ≤ (x + 1)) ∧ ((x + 1) ≤ 127)
u2(n, x) -> ret_Int(x) | ¬(n > 0)
